# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.superpowers/
.claude/
/test-results/
/playwright-report/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Internal docs (exclude all .md except README)
*.md
!README.md
!CLAUDE.md
!DESIGN.md
!PRODUCT.md

# Documentation de travail : specs, plans, journaux et rapports de relecture.
# Le dépôt est public et ces fichiers portent des données commerciales
# (montants facturés, TJM, marges). Ils restent sur disque, jamais poussés.
/docs/
